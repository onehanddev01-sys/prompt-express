rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasAccount() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'employee'];
    }

    function isAdmin() {
      return hasAccount()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validCustomer(data) {
      return data.keys().hasOnly(['name', 'phone', 'customerName', 'address', 'createdAt', 'createdBy'])
        && data.keys().hasAll(['name', 'phone', 'customerName', 'address', 'createdAt', 'createdBy'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.phone is string
        && data.phone.size() > 0
        && data.phone.size() <= 40
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() <= 120
        && data.address is string
        && data.address.size() > 0
        && data.address.size() <= 300;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'role', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.role in ['admin', 'employee'];
      allow update: if isAdmin()
        && request.auth.uid != userId
        && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt'])
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.role in ['admin', 'employee'];
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if hasAccount();
      allow create: if hasAccount()
        && validCustomer(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasAccount()
        && validCustomer(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }
  }
}
